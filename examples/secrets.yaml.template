# secrets.yaml — Template
#
# Copy this file to your ESPHome config directory as "secrets.yaml"
# and fill in your actual values.  NEVER commit this file to version control.
#
# The .gitignore in this repository already excludes secrets.yaml.

wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"

ha_api_key: "YOUR_HA_API_ENCRYPTION_KEY"   # generate: esphome generate-api-key
ota_password: "YOUR_OTA_PASSWORD"
